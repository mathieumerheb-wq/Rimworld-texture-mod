  <!-- Breasts only, so a full anthro can pair it with any genital gene above. It has its own
       exclusion tag and runs after the genital genes (order 31), and leaves the other parts alone. -->
  <GeneDef>
    <defName>RJWAT_mammal_breasts</defName>
    <label>mammal breasts</label>
    <description>Carriers of this gene have mammal breasts.</description>
    <iconPath>Genes/Icons/Extra_Breasts</iconPath>
    <displayCategory>rjw_genes_genitalia_type</displayCategory>
    <geneClass>RJW_Genes.Gene_GenitaliaType</geneClass>
    <exclusionTags>
      <li>RJWAT_BreastType</li>
    </exclusionTags>
    <biostatCpx>0</biostatCpx>
    <modExtensions>
      <li MayRequire="OskarPotocki.VanillaFactionsExpanded.Core" Class="VEF.Genes.GeneExtension">
        <backgroundPathEndogenes>Genes/Icons/RJW_Genes_Endogene_Background</backgroundPathEndogenes>
        <backgroundPathXenogenes>Genes/Icons/RJW_Genes_Xenogene_Background</backgroundPathXenogenes>
      </li>
      <li Class="RJW_Genes.SexualizerGeneExtension">
        <order>31</order>
      </li>
      <li Class="RJW_Genes.GenitaliaTypeExtension">
        <breasts>MammalBreasts</breasts>
      </li>
    </modExtensions>
    <displayOrderInCategory>815</displayOrderInCategory>
  </GeneDef>

</Defs>
