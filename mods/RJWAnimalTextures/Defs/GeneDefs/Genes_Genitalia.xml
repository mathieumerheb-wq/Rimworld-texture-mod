<Defs>

  <GeneDef ParentName="GeneGenitalTypeBase">
    <defName>RJWAT_fox_genitalia</defName>
    <label>fox genitalia</label>
    <description>Carriers of this gene have fox genitalia.</description>
    <iconPath>Genes/Icons/RJWAT_fox</iconPath>
    <modExtensions>
      <li Class="RJW_Genes.GenitaliaTypeExtension">
        <penis>FoxPenis</penis>
        <vagina>DogVagina</vagina>
        <anus>DogAnus</anus>
      </li>
    </modExtensions>
    <displayOrderInCategory>808</displayOrderInCategory>
  </GeneDef>

