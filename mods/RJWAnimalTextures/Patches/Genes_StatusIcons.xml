<?xml version="1.0" encoding="utf-8"?>
<!--
  Gives every genital gene an icon of the penis it draws, with a mark for how finished that sprite is.
  Icons come from ArtInventory/Build-GeneIcons.ps1. Each operation succeeds when the gene's mod is absent.
-->
